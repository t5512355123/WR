* text=auto

/.gitattributes text eol=lf
/.gitignore text eol=lf

# 原始碼、腳本、Quartus 專案與文件一律以 LF 儲存，避免 Windows/Linux 假差異。
*.c text eol=lf
*.h text eol=lf
*.v text eol=lf
*.vh text eol=lf
*.vhd text eol=lf
*.vhdl text eol=lf
*.wb text eol=lf
*.tcl text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.qpf text eol=lf
*.qsf text eol=lf
*.sdc text eol=lf
*.md text eol=lf
*.txt text eol=lf

# 二進位檔不做換行轉換。
*.bin binary
*.elf binary
*.mif binary
*.sof binary
*.pof binary
*.a binary
*.o binary
*.so binary

# Checksum-sensitive evidence must survive Windows checkouts byte-for-byte.
*.log -text
*.sha256 -text
SHA256SUMS -text
/experiments/repository-cleanup/EXP-REPO-ARTIFACTS-CONSOLIDATION-20260924/analysis/*.tsv -text

# Frozen milestone snapshots are byte-preserving packages. Do not let
# core.autocrlf rewrite generated Qsys/QIP metadata or their source manifests.
artifacts/milestones/**/source/** -text -eol
artifacts/milestones/**/source/** -whitespace
# Upstream WR-core test fixture is a captured Tcl stacktrace containing literal
# stash-conflict labels; preserve it byte-for-byte, but do not parse it as a diff.
artifacts/milestones/step6_global_time/source/vendor/wr-cores/testbench/wr_streamers/streamers-only_basic-transfer/tcl_stacktrace.txt -diff
# Candidate frozen source packages inside experiments are also byte-preserving.
experiments/step5/EXP-S5-MILESTONE-REPRO-20260924/source/** -text -eol
