* text=auto

/.gitattributes text eol=lf
/.gitignore text eol=lf

# 原始碼、腳本、Quartus 專案與文件一律以 LF 儲存，避免 Windows/Linux 假差異。
*.c text eol=lf
*.h text eol=lf
*.v text eol=lf
*.vh text eol=lf
*.vhd text eol=lf
*.vhdl text eol=lf
*.tcl text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.qpf text eol=lf
*.qsf text eol=lf
*.sdc text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.sha256 text eol=lf
*.stp text eol=lf
*.defconfig text eol=lf

# 二進位檔不做換行轉換。
*.bin binary
*.elf binary
*.mif binary
*.sof binary
*.pof binary
*.a binary
*.o binary
*.so binary
