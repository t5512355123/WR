comment "commands"

config CMD_CONFIG
	depends on WR_NODE
	boolean "Add 'config' command to display this configuration"
	help
	  This options adds the "config" command to the shell, which
	  reports the current configuration.  This adds half a kilobyte
	  to the binary size (100b for the code plus the .config file).

config BUILD_INIT
	depends on WR_NODE
	default n
	boolean "Add 'init' command in the binary (build-time)"

config INIT_COMMAND
	depends on BUILD_INIT
	string "Enter the init command, use ';' as command separator"
	default ""

# The following two integer values are derived, and used in if() (shell.c)
config HAS_FLASH_INIT
	int
	default 1 if FLASH_INIT
	default 0

config FLASH_INIT
	boolean
	default y if EMBEDDED_NODE
	default n

config CMD_CALIBRATION_SHOW
	depends on WR_NODE
	boolean "Add 'calibration show' command to print all calibration values"
	default n
	help
	  Adds an "show" to the calibration command to print all
	  calibration values.

config CMD_REFRESH
	depends on WR_NODE
	boolean "Add 'refresh' command"
	default n
	help
	  This enables refresh command, which can be used to change the refresh
	  period of gui and printout period of stat command.

config CMD_PPS
	depends on WR_NODE
	boolean "Add 'pps' command"
	default n
	help
	  This enables pps command, which can be used to force PPS output
	  all the time for all clock classes.

config CMD_SFP_INFO
	depends on WR_NODE
	boolean "Add 'sfp info' command to print info about SFP"
	default n
	help
	  Adds an "info" parameter to the sfp command to print information about
	  the inserted SFP like Nominal Bit Rate, Vendor Name, Vendor PN,
	  Vendor serial, TX Wavelength. Even if this option is not selected
	  it is possible to read the mentioned values via wrpc-dump.

config SFP_DOM
	depends on WR_NODE
	boolean "Extend 'sfp info' command with SFP monitoring info"
	default n
	help
	  This enables extensions to sfp command, which allows read of
	  monitoring information from SFP like: TX/RX power, voltage,
	  bias current, temperature. If CMD_SFP_INFO is not selected, it is
	  possible to read monitoring data via wrpc-dump.

config CMD_LEAPSEC
	depends on WR_NODE
	boolean "Add 'leapsec' command to control leapsecond value"
	default n
	help
	  This enables leapsec command, which can be used to adjust leap seconds
	  value.

config CMD_PTP_ADV
	depends on WRPC_PPSI
	boolean "Extend 'ptp' command with extra subcommands"
	default n
	help
	  Extend ptp command with extra subcommands:
	  --param1
	  --param2
	  --domain (domain number)
	  --class (clock class)
	  --accuracy (clock accuracy)
	  --allan (clock allan variance)

config CMD_NETCONSOLE
	depends on NETCONSOLE
	boolean "Add 'netconsole' command to configure netconsole"
	default y
	help
	  Include command to configure netconsole

config CMD_MONITOR_SERVO_ERR
       depends on WR_NODE
       boolean "Extend 'gui' and 'stat' commands with stats for servo errors"
       default n

config FREQUENCY_MONITOR
	boolean "Add 'freqmon' command for built-on clock frequency monitor"
	default n
	help
	  Enables the "freqmon" command in the WRC shell which lets
	  the user check all relevant clock frequencies (REF, DMTD,
	  RX, AUX, EXT) as well as the oscillators' tuning range.
	  Requires g_with_clock_freq_monitor to be enabled in the HDL
	  IP instantiation.

comment "wrpc-sw is tainted if you change the following options"
config DEVELOPER
	depends on WR_NODE
	bool "Advanced configurations, only for developers"
	help
	  The following options are new features under testing, or
	  special customizations not normally useful for people not
	  directly working on this package.  Please don't use unless
	  you are a developer of wrpc-sw.

#
# This is a set of configuration options that should not be changed by
# normal users. If the "developer" menu is used, the binary is tainted.

config TRACE_MSGS
	bool "Control of trace/debug messages verbosity"

config TRACE_ALL_ENABLE
	depends on TRACE_MSGS
	bool "Print all trace messages"
	default n

config TRACE_MAIN_ENABLE
	depends on TRACE_MSGS
	bool "Print main module trace messages"
	default n

config TRACE_STORAGE_ENABLE
	depends on TRACE_MSGS
	bool "Print storage module trace messages"
	default n

config TRACE_DEVICES_ENABLE
	depends on TRACE_MSGS
	bool "Print device driver trace messages"
	default n

config TRACE_BOARD_ENABLE
	depends on TRACE_MSGS
	bool "Print board-specific trace messages"
	default n

config TRACE_MAC_ENABLE
	depends on TRACE_MSGS
	bool "Print WR Endpoint/MAC/Minic trace messages"
	default n

config TRACE_PHY_ENABLE
	depends on TRACE_MSGS
	bool "Print PHY/PCS trace messages"
	default n


