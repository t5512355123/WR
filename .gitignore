# Quartus and other rebuildable outputs
build/*
!build/.gitkeep
db/
incremental_db/
output_files/
simulation/
**/db/
**/incremental_db/
**/output_files/
**/output_files_*/
*.rpt
*.summary
*.log
*.sof
*.pof
*.elf
*.bin
*.mif
*.o
*.d
*.a
*.so
*.map
*.size
*.bram
*.vhd.tmp
*.qdb
*.qws
*.qmsg
*.qdf
*.srf
*.done
*.pin
*.jdi
*.smsg

# 正式實驗的原始證據需保留並提交至 GitHub。
!experiments/**/*.log

# Generated files inside the vendored WRPC source tree
vendor/wrpc-sw/wrc.*
vendor/wrpc-sw/.config*
vendor/wrpc-sw/*.d
vendor/wrpc-sw/*.o
vendor/wrpc-sw/*.elf
vendor/wrpc-sw/*.bin
vendor/wrpc-sw/*.mif

# Local/editor/OS files
.DS_Store
Thumbs.db
*.swp
*.swo
__pycache__/

# Legacy local-only bundles are not canonical artifacts. Experiment evidence
# belongs under experiments/ and is intentionally tracked there.
artifacts/EXP-*/

# Rebuilt milestone bitstreams are release artifacts and must be versioned.
!artifacts/milestones/**/master.sof
!artifacts/milestones/**/slave.sof
